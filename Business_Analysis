---- Answering Business questions 

-- Which menu items are the restaurant's strongest performers?
SELECT
    mi.item_name,
    COUNT(*) AS quantity_sold,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY total_revenue DESC;

-- Are the most frequently ordered items also the highest-revenue items?
SELECT
    mi.item_name,
    COUNT(*) AS quantity_sold,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY quantity_sold DESC;

-- Which category appears to be the restaurant's strongest category?
SELECT 
category
