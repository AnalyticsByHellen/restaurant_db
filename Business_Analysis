-- Which menu items have high sales volume but relatively low revenue?
WITH item_performance AS (
    SELECT
        mi.item_name,
        COUNT(*) AS quantity_sold,
        SUM(mi.price) AS total_revenue
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY mi.item_name
)

SELECT
    item_name,
    quantity_sold,
    total_revenue,
    CASE
        WHEN quantity_sold > (SELECT AVG(quantity_sold) FROM item_performance)
         AND total_revenue < (SELECT AVG(total_revenue) FROM item_performance)
        THEN 'High Volume - Low Revenue'
    END AS performance_type
FROM item_performance
WHERE quantity_sold > (SELECT AVG(quantity_sold) FROM item_performance)
  AND total_revenue < (SELECT AVG(total_revenue) FROM item_performance);

-- Which menu items have low sales volume but relatively high revenue?
WITH item_performance AS (
    SELECT
        mi.item_name,
        COUNT(*) AS quantity_sold,
        SUM(mi.price) AS total_revenue
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY mi.item_name
)

SELECT
    item_name,
    quantity_sold,
    total_revenue,
    CASE
        WHEN quantity_sold < (SELECT AVG(quantity_sold) FROM item_performance)
         AND total_revenue > (SELECT AVG(total_revenue) FROM item_performance)
        THEN 'Low Volume - High Revenue'
    END AS performance_type
FROM item_performance
WHERE quantity_sold < (SELECT AVG(quantity_sold) FROM item_performance)
  AND total_revenue > (SELECT AVG(total_revenue) FROM item_performance);
  
  -- Which category has the most expensive menu items but doesn't necessarily have the highest sales?
  SELECT
    mi.category,
    AVG(mi.price) AS average_price,
    COUNT(od.item_id) AS quantity_sold,
    SUM(mi.price) AS total_revenue
FROM menu_items mi
LEFT JOIN order_details od
    ON mi.menu_item_id = od.item_id
GROUP BY mi.category
ORDER BY average_price DESC;

-- What are the restaurant's top 5 revenue-generating menu items
SELECT
    mi.item_name,
    COUNT(*) AS quantity_sold,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY total_revenue DESC
LIMIT 5;

-- What are the restaurant's top 3 categories by revenue?
SELECT
    mi.category,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY total_revenue DESC
LIMIT 3;

-- What percentage of revenue comes from the top 5 menu items?
WITH item_revenue AS (
    SELECT
        mi.item_name,
        SUM(mi.price) AS total_revenue
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY mi.item_name
),

top_5 AS (
    SELECT
        item_name,
        total_revenue
    FROM item_revenue
    ORDER BY total_revenue DESC
    LIMIT 5
),

total_revenue AS (
    SELECT
        SUM(total_revenue) AS revenue
    FROM item_revenue
)

SELECT
    ROUND(
        (SELECT SUM(total_revenue) FROM top_5)
        /
        (SELECT revenue FROM total_revenue)
        * 100,
        2
    ) AS top_5_revenue_percentage;
    
    -- What percentage of total orders contain more than 3 items?
    WITH order_counts AS (
    SELECT
        order_id,
        COUNT(*) AS item_count
    FROM order_details
    GROUP BY order_id
)

SELECT
    ROUND(
        SUM(CASE WHEN item_count > 3 THEN 1 ELSE 0 END)
        / COUNT(*) * 100,
        2
    ) AS percentage_orders_over_3_items
FROM order_counts
