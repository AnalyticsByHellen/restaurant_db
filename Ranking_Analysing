-- RANKING
-- Rank all menu items by number of times ordered.
SELECT 
mi.item_name,
COUNT(*) AS timesordererd,
RANK() OVER( ORDER BY COUNT(*) DESC) AS orderedrank
FROM order_details od
  JOIN menu_items mi
ON mi.menu_item_id = od.order_id
GROUP BY mi.item_name
ORDER BY orderedrank;

-- Rank all menu items by revenue.
SELECT 
mi.item_name,
SUM(mi.price) AS totalrevenue,
RANK() OVER( ORDER BY SUM(mi.price)  DESC) AS totalrevenue
FROM order_details od
  JOIN menu_items mi
ON mi.menu_item_id = od.order_id
GROUP BY mi.item_name
ORDER BY totalrevenue;

-- Rank menu items within each category by revenue
SELECT
    mi.category,
    mi.item_name,
    SUM(mi.price) AS total_revenue,
    RANK() OVER (
        PARTITION BY mi.category
        ORDER BY SUM(mi.price) DESC
    ) AS category_revenue_rank
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY
    mi.category,
    mi.item_name
ORDER BY
    mi.category,
    category_revenue_rank;
    
-- Find the top 3 menu items in each category
WITH ranked_items AS (
    SELECT
        mi.category,
        mi.item_name,
        SUM(mi.price) AS total_revenue,
        RANK() OVER (
            PARTITION BY mi.category
            ORDER BY SUM(mi.price) DESC
        ) AS category_rank
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY
        mi.category,
        mi.item_name
)
SELECT
    category,
    item_name,
    total_revenue,
    category_rank
FROM ranked_items
WHERE category_rank <= 3
ORDER BY category, category_rank;
    
-- Find the bottom 3 menu items in each category
WITH ranked_items AS (
    SELECT
        mi.category,
        mi.item_name,
        SUM(mi.price) AS total_revenue,
        RANK() OVER (
            PARTITION BY mi.category
            ORDER BY SUM(mi.price) ASC
        ) AS category_rank
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY
        mi.category,
        mi.item_name
)
SELECT
    category,
    item_name,
    total_revenue,
    category_rank
FROM ranked_items
WHERE category_rank <= 3
ORDER BY category, category_rank;

-- Top 5 menu items overall by revenue
SELECT
    mi.item_name,
    SUM(mi.price) AS total_revenue,
    RANK() OVER (
        ORDER BY SUM(mi.price) DESC
    ) AS category_revenue_rank
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY
     mi.item_name
ORDER BY category_revenue_rank 
LIMIT 5;

-- Top 5 menu items overall by quantity sold
SELECT
    mi.item_name,
    COUNT(*) AS total_quantity,
    RANK() OVER (
        ORDER BY COUNT(*) DESC
    ) AS quantity_rank
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY
     mi.item_name
ORDER BY quantity_rank 
LIMIT 5;

-- Which menu items are in the top 10% by revenue?
WITH ranked_items AS (
    SELECT
        mi.item_name,
        SUM(mi.price) AS total_revenue,
        NTILE(10) OVER (
            ORDER BY SUM(mi.price) DESC
        ) AS revenue_decile
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY mi.item_name
)

SELECT
    item_name,
    total_revenue
FROM ranked_items
WHERE revenue_decile = 1
ORDER BY total_revenue DESC;

