-- JOINING TABLES
-- Show each order detail together with the menu item name.
SELECT
    od.order_details_id,
    od.order_id,
    od.item_id,
    mi.item_name
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id;
    
    -- Show each order detail with the item name, category and price.
    SELECT
    od.order_details_id,
    od.order_id,
    od.item_id,
    mi.item_name,
    category,
    price
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id;
    
    -- How many times was each menu item ordered?
    SELECT
    mi.item_name,
    COUNT(*) AS times_ordered
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY times_ordered DESC;
 
 -- Which menu item was ordered the most?
     SELECT
    mi.item_name,
    COUNT(*) AS times_ordered
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY times_ordered DESC
LIMIT 1;

-- Which menu item was ordered the least?
     SELECT
    mi.item_name,
    COUNT(*) AS times_ordered
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY times_ordered ASC
LIMIT 1;

-- Which menu items were never ordered?
SELECT
    mi.menu_item_id,
    mi.item_name
FROM menu_items mi
LEFT JOIN order_details od
    ON mi.menu_item_id = od.item_id
WHERE od.item_id IS NULL;

-- How many times was each category ordered?
SELECT
    mi.category,
    COUNT(*) AS times_ordered
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY times_ordered DESC;

-- Which category has the highest number of items ordered?
SELECT
    mi.category,
    COUNT(*) AS times_ordered
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY times_ordered DESC
LIMIT 1 ;

-- What percentage of total items ordered does each category represent?
SELECT
    mi.category,
    COUNT(*) AS items_ordered,
    ROUND(
        COUNT(*) * 100.0 /
        (SELECT COUNT(*)
         FROM order_details
         WHERE item_id IS NOT NULL),
        2
    ) AS percentage_of_total
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY percentage_of_total DESC;

-- Which category generates the most revenue?
SELECT
    mi.category,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY total_revenue DESC
LIMIT 1;

-- REVENUE ANALYSIS
-- What is the total revenue generated?
SELECT
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id;
    
    -- What is the average revenue per order?
    WITH order_revenue AS (
    SELECT
        od.order_id,
        SUM(mi.price) AS order_revenue
    FROM order_details od
    JOIN menu_items mi
        ON od.item_id = mi.menu_item_id
    GROUP BY od.order_id
)

SELECT
    ROUND(AVG(order_revenue), 2) AS average_revenue_per_order
FROM order_revenue;

-- What is the average value of an order?
SELECT
    ROUND(
        SUM(mi.price) / COUNT(DISTINCT od.order_id),
        2
    ) AS average_order_value
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id;
    
-- What is the total revenue generated by each menu item?
SELECT
    mi.item_name,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY total_revenue DESC;

-- Which menu item generated the highest revenue?
SELECT
    mi.item_name,
    SUM(mi.price) AS total_revenue
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY total_revenue DESC
LIMIT 1;

-- What percentage of total revenue does each menu item contribute?
SELECT
    mi.item_name,
    SUM(mi.price) AS item_revenue,
    ROUND(
        SUM(mi.price) * 100.0 /
        (SELECT SUM(mi2.price)
         FROM order_details od2
         JOIN menu_items mi2
             ON od2.item_id = mi2.menu_item_id),
        2
    ) AS revenue_percentage
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.item_name
ORDER BY revenue_percentage DESC;

-- What percentage of total revenue comes from each category?
SELECT
    mi.category,
    SUM(mi.price) AS category_revenue,
    ROUND(
        SUM(mi.price) * 100.0 /
        (SELECT SUM(mi2.price)
         FROM order_details od2
         JOIN menu_items mi2
             ON od2.item_id = mi2.menu_item_id),
        2
    ) AS revenue_percentage
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY revenue_percentage DESC;

-- Rank the categories by revenue.
SELECT
    mi.category,
    SUM(mi.price) AS total_revenue,
    RANK() OVER (
        ORDER BY SUM(mi.price) DESC
    ) AS revenue_rank
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY mi.category
ORDER BY revenue_rank;

-- Within each category, rank the menu items by revenue.
SELECT
    mi.category,
    mi.item_name,
    SUM(mi.price) AS total_revenue,
    RANK() OVER (
        PARTITION BY mi.category
        ORDER BY SUM(mi.price) DESC
    ) AS category_revenue_rank
FROM order_details od
JOIN menu_items mi
    ON od.item_id = mi.menu_item_id
GROUP BY
    mi.category,
    mi.item_name
ORDER BY
    mi.category,
    category_revenue_rank;
