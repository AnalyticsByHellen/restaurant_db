-- DATE & TIME ANALYSIS
-- How many orders were placed each day?
SELECT
    order_date,
    COUNT(DISTINCT order_date) AS ordersplaced
 FROM order_details
 GROUP BY order_date
 ORDER BY order_date;
 
 -- Which day had the highest number of orders?
SELECT
    order_date,
    COUNT(DISTINCT order_date) AS ordersplaced
 FROM order_details
 GROUP BY order_date
 ORDER BY  ordersplaced DESC
 LIMIT 1 ;
 
 -- Which day generated the highest revenue?
 SELECT
  od.order_date,
    SUM(mi.price) AS total_revenue
    FROM order_details od
JOIN  menu_items mi
ON od.order_details_id = mi. menu_item_id
GROUP BY od.order_date
ORDER BY total_revenue
LIMIT 1;

-- How many orders were placed each month?
SELECT
    DATE_FORMAT(order_date, '%Y-%m') AS order_month,
    COUNT(DISTINCT order_id) AS total_orders
FROM order_details
GROUP BY DATE_FORMAT(order_date, '%Y-%m')
ORDER BY order_month;

-- What was the total revenue for each month?
SELECT
    DATE_FORMAT(od.order_date, '%Y-%m') AS order_month,
    SUM(mi.price) AS totalRevenue
FROM order_details od
JOIN menu_items mi
ON od.item_id = mi.menu_item_id
GROUP BY DATE_FORMAT(od.order_date, '%Y-%m')
ORDER BY order_month;

-- Which month generated the most revenue?
SELECT
    DATE_FORMAT(od.order_date, '%Y-%m') AS order_month,
    SUM(mi.price) AS totalRevenue
FROM order_details od
JOIN menu_items mi
ON od.item_id = mi.menu_item_id
GROUP BY DATE_FORMAT(od.order_date, '%Y-%m')
ORDER BY order_month
LIMIT 1;

-- How many items were ordered on each day of the week?
SELECT
DAYNAME(order_date) AS Daysoftheweek,
COUNT(*) AS Itemordered
FROM order_details
GROUP BY DAYNAME(order_date);

-- Which day of the week is the busiest?
SELECT
DAYNAME(order_date) AS Daysoftheweek,
COUNT(*) AS Itemordered
FROM order_details
GROUP BY DAYNAME(order_date)
ORDER BY Itemordered DESC
LIMIT 1;

-- Which day of the week generates the most revenue?
SELECT
   DAYNAME(order_date) AS Daysoftheweek,
    SUM(mi.price) AS totalRevenue
FROM order_details od
JOIN menu_items mi
ON od.item_id = mi.menu_item_id
GROUP BY DAYNAME(order_date)
ORDER BY totalRevenue DESC
LIMIT 1;
